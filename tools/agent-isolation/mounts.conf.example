# mounts.conf — Declare directories to mount into the container.
#
# Format: <host-path>  <mode>  [<name>]
#
#   host-path : Absolute path or ~ for $HOME. Required.
#   mode      : rw | ro | mcp. Required.
#   name      : Container directory name. Optional, defaults to basename of host-path.
#
# Convention:
#   claude mounts to ~/.claude        (read-write, synced config — at most one)
#   rw     mounts go to /workspace/<name>  (read-write)
#   ro     mounts go to /reference/<name>  (read-only)
#   mcp    mounts go to /mcp/<name>        (read-only, host paths rewritten in config)
#
#   The first rw entry becomes the container's working directory.
#   If no claude entry, container uses ephemeral ~/.claude (not preserved).
#
# Lines starting with # and blank lines are ignored.

# Claude Code config — synced from ~/.claude via sync-config.sh
# Persists sessions, settings, and conversation history outside the container.
~/agent-workspace/agent-claude  claude

# Target project
/path/to/my-project  rw

# Read-only reference repos (uncomment as needed)
# /path/to/some-reference-repo  ro
# /path/to/design-system        ro

# Local MCP servers — mounted and paths rewritten so Claude Code can find them
# /path/to/my-mcp-server      mcp
# /path/to/another-mcp-server mcp
