# hermes container config — one file per container.
#
#   init-hermes-container <this-file>
#
# generates the container's docker-compose.yml inside `hermes_workspace`.
# This file holds secrets (API keys, SSH password) — keep it OUT of git.

# ── identity ────────────────────────────────────────────────────────
container_name: hermes-personal      # required; names the containers + compose project
hermes_workspace: ~/hermes/personal  # required; root folder for this container's state
                                     #   (creates <ws>/hermes and <ws>/claude-code)
launch_on_boot: true                 # true → restart: unless-stopped; false → restart: "no"

# ── ports ───────────────────────────────────────────────────────────
# All optional. Omitted ports are auto-assigned to the next free port.
ports:
  gateway: 8642        # Hermes gateway API   (bound to 127.0.0.1)
  dashboard: 9119      # Hermes web dashboard (bound to 127.0.0.1)
  ssh: 2222            # SSH into the container

# ── ssh ─────────────────────────────────────────────────────────────
# SSH access to drive the Hermes TUI over a real PTY. Login is the hermes
# user — password and/or public key.
ssh:
  enabled: true                           # default true
  password: change-me                     # the hermes user's login password
  # authorized_key: ~/.ssh/id_ed25519.pub  # optional; key auth, preferred when set
# When ssh.enabled, you must set `password` or `authorized_key` (never open).
# To disable SSH entirely:  ssh: { enabled: false }

# ── env ─────────────────────────────────────────────────────────────
# Passed into the gateway container. Put LLM provider keys here.
env:
  ANTHROPIC_API_KEY: sk-ant-xxxxxxxxxxxxxxxx
  # OPENAI_API_KEY: ...
  # DISCORD_BOT_TOKEN: ...

# ── mounts ──────────────────────────────────────────────────────────
# Workspaces (rw — agent can edit) and references (ro — read-only).
# `target` is optional:
#   omitted   → /workspace/<basename>  or  /reference/<basename>
#   relative  → placed under /workspace or /reference (slashes allowed)
#   absolute  → used verbatim (must not be at/under /opt/data)
mounts:
  - { host: ~/workspace/my-project, mode: rw }
  - { host: ~/docs, mode: ro, target: design-docs }
