# Sekko narration configuration
# Copy this file to .env and configure as needed

# Transcription backend: "whisper" (local, default) or "deepgram" (cloud)
SEKKO_TRANSCRIPTION_MODE=whisper

# Required if SEKKO_TRANSCRIPTION_MODE=deepgram
# DEEPGRAM_API_KEY=your_api_key_here

# Whisper binary name or path (default: whisper-cli)
# SEKKO_WHISPER_CLI=whisper-cpp

# Whisper model file path (default: ~/.sekko/models/ggml-small.en.bin)
# SEKKO_WHISPER_MODEL=~/dev/whisper.cpp/models/ggml-large-v3-turbo.bin
